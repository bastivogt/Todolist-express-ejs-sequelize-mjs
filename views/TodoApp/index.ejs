<%- include('../includes/_header') %>
    <h1><%= title %></h1>
    <p><a href="/todos/create">Create New Todo</a></p>
    <% if(todos && todos.length > 0) { %>
        <ul>
            <% todos.forEach(todo => { %>
                <li><a href="/todos/<%= todo.id %>"><%= todo.title %></a></li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No todos found.</p>
    <% } %> 
<%- include('../includes/_footer') %>   